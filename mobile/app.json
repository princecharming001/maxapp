{
  "expo": {
    "name": "Superpower",
    "slug": "cannon-mobile",
    "version": "3.1.5",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f3fa5d9c-7073-4b53-9376-6b2f693c6a39",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cannon.mobile",
      "appleTeamId": "3TJ8RC3JCX",
      "buildNumber": "348",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.cannon.mobile"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Superpower uses your photo library to attach images in community channels, chat, and profile or progress photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0EFEC"
      },
      "package": "com.cannon.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-apple-authentication",
      "./plugins/withModularHeaders",
      [
        "expo-image-picker",
        {
          "photosPermission": "Superpower uses your photo library to attach images in community channels, chat, and profile or progress photos.",
          "cameraPermission": "Allow Superpower to use your camera to take photos for posts and progress.",
          "microphonePermission": "Allow Superpower to use your microphone for voice messages."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Superpower opens the contacts picker so you can choose a friend to text. Only the contact you pick is used, and your contact list is never uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      "react-native-iap",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.459211330867-j5tppv11imgt45uiunbbpg1d9hplbh0o"
        }
      ]
    ],
    "newArchEnabled": true,
    "scheme": "cannon",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "f3fa5d9c-7073-4b53-9376-6b2f693c6a39"
      },
      "supportEmail": "mog.max123@gmail.com",
      "privacyPolicyUrl": "https://maxmaxmax.today/legal/privacy",
      "termsOfServiceUrl": "https://maxmaxmax.today/legal/terms",
      "communityGuidelinesUrl": "https://maxmaxmax.today/legal/community-guidelines",
      "cookieNoticeUrl": "https://maxmaxmax.today/legal/cookies",
      "sendblueSmsNumber": "+16468304204",
      "sendblueDisplayNumber": "+1 (646) 830-4204"
    }
  }
}
